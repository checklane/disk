{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "import", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "import/newline-after-import": ["error", { "count": 1 }]
  },
  "ignorePatterns": ["dist/**"]
}
